rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== GELİŞTİRME MODU: TÜM ERİŞİM AÇIK =====
    // UYARI: Canlı yayında admin kontrolü ekleyin!
    
    // ===== ÜRÜNLER =====
    match /products/{productId} {
      allow read: if true; // Herkes okuyabilir
      allow write: if true; // GELİŞTİRME: Herkes yazabilir (ÜRETİMDE DEĞİŞTİRİN!)
    }
    
    // ===== MARKALAR =====
    match /brands/{brandDoc} {
      allow read: if true;
      allow write: if true; // GELİŞTİRME: Herkes yazabilir
    }
    
    // ===== MÜŞTERİLER =====
    match /customers/{customerId} {
      allow read, write: if true; // GELİŞTİRME: Herkes erişebilir
    }
    
    // ===== SİPARİŞLER =====
    match /orders/{orderId} {
      allow read, write: if true; // GELİŞTİRME: Herkes erişebilir
    }
    
    // ===== KATEGORİLER =====
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    // ===== AYARLAR =====
    match /settings/{settingDoc} {
      allow read, write: if true;
    }
  }
}
